{
  "name": "symphony-landing-page-agent-comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/contract.test.mjs",
    "provision": "node src/provision.mjs",
    "run:cell": "node src/run-cell.mjs",
    "run:default": "SYMPHONY_BENCH_MATRIX=providers-default node src/run-matrix.mjs",
    "run:advanced": "SYMPHONY_BENCH_MATRIX=providers-advanced node src/run-matrix.mjs",
    "run:codex-5.6": "SYMPHONY_BENCH_MATRIX=codex-5.6-defaults node src/run-matrix.mjs",
    "collect": "node src/collect.mjs",
    "capture:visuals": "node src/capture-visuals.mjs",
    "e2e": "playwright test e2e/symphony-flow.spec.mjs --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1"
  }
}
