# Hermetic environment for the test suite, loaded by `make test` / `make coverage`.
#
# A developer's `.env` (real GitHub token, Cloudflare tunnel domain, etc.) is
# commonly present in the shell and leaks into `MIX_ENV=test`, making
# environment-dependent tests fail locally even though they pass in CI (e.g. the
# dev-server preview URL resolves to a public `*.tracker.cods.dev` host instead
# of `127.0.0.1`). This file overrides those values with blank/test-safe ones so
# the suite runs the same way everywhere.
#
# Keep every secret blank. Blank is treated as "unset" by the app
# (e.g. GitHub.Config.normalize_secret/1 maps "" -> nil).

# --- Auth / secrets --------------------------------------------------------
# Blank so token-gated code paths take their deterministic "unset" branch.
SYMPHONY_TRACKER_TOKEN=
GITHUB_TOKEN=

# --- Public preview tunnel (Cloudflare) ------------------------------------
# Blank namespace + token means no preview namespace can be resolved, so
# dev-server URLs stay on 127.0.0.1 instead of a public tunnel host.
PUBLIC_NAMESPACE=
PUBLIC_TUNNEL_BASE_DOMAIN=
PUBLIC_TUNNEL_ROUTE_DNS=false
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARED_TUNNEL_NAME=

# --- Local tracker database ------------------------------------------------
# The test config already pins its own SQLite path under tmp/ and ignores this
# override, but blank it anyway so a sourced developer .env can never point the
# test suite at real data.
SYMPHONY_LOCAL_TRACKER_DATABASE=
