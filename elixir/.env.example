# Copy to `.env` and fill in the values for your environment.
# Quick bootstrap (requires authenticated gh): make env-setup
# Blank secrets are treated as "unset" by the app.

SYMPHONY_TRACKER_TOKEN=
GITHUB_TOKEN=

# --- Product branding (surface name / assets; internal OTP names stay Symphony) ---
# SYMPHONY_BRAND_PRODUCT_NAME=Dev10x
# SYMPHONY_BRAND_TRACKER_TITLE=Dev10x
# SYMPHONY_BRAND_CLI_PRODUCT_NAME=Dev10x
# SYMPHONY_BRAND_ICON_PATH=dev10x_icon.png
# SYMPHONY_BRAND_FAVICON_PATH=favicon.png
# SYMPHONY_BRAND_LOGO_COLOR_PATH=dev10x_logo_color.png
# SYMPHONY_BRAND_LOGO_BLACK_PATH=dev10x_logo_black.png
# SYMPHONY_BRAND_LOGO_WHITE_PATH=dev10x_logo_white.png

# --- JIRA Cloud tracker ----------------------------------------------------
# Used when the active tracker kind is "jira" (set jira.project_key in the project's workflow_markdown).
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Optional: restrict polling to a single assignee (defaults to JIRA_EMAIL).
JIRA_ASSIGNEE=

# --- Notion import ---------------------------------------------------------
# Integration token for import_notion_page / Settings → Providers → Notion.
NOTION_API_KEY=

# Local tracker SQLite database path (relative to the elixir/ working dir, or absolute).
SYMPHONY_LOCAL_TRACKER_DATABASE=.symphony/tracker.sqlite3

# How long (ms) a write waits for SQLite's single writer lock before failing with
# "Database busy". Raise it if background sync + UI writes still collide under load.
SYMPHONY_LOCAL_TRACKER_BUSY_TIMEOUT_MS=5000

# --- Public preview tunnel (Cloudflare) ------------------------------------
# Exposes the tracker + dev-server previews via a Cloudflare named tunnel.
# Leave the secrets blank to keep the tunnel disabled.
CLOUDFLARE_ZONE_NAME=cods.dev
PUBLIC_TUNNEL_BASE_DOMAIN=tracker.cods.dev
CLOUDFLARED_TUNNEL_NAME=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ZONE_ID=

# Override the preview namespace (defaults to the operator's GitHub login).
PUBLIC_NAMESPACE=
# When "true", `make tunnel` runs `mix symphony.tunnel.dns` before starting.
PUBLIC_TUNNEL_ROUTE_DNS=false

# --- Browser editor (code-server) -------------------------------------------
# Process-wide editor settings (not per-project workflow_markdown).
# SYMPHONY_EDITOR_ENABLED=true
# SYMPHONY_EDITOR_PORT=4002
# SYMPHONY_EDITOR_HOST=127.0.0.1

# --- Preview port pool (node-level) -----------------------------------------
# Bands of SLOTS_PER_PROJECT * PORTS_PER_SLOT ports are carved from this range;
# each project leases one band and each running issue leases a slot inside it.
# Keep below the OS ephemeral range (32768+) to avoid collisions.
# SYMPHONY_PREVIEW_POOL=10000-30000
# SYMPHONY_PREVIEW_SLOTS_PER_PROJECT=32
# SYMPHONY_PREVIEW_PORTS_PER_SLOT=8

# --- GitHub polling & tracker sync cadence ----------------------------------
# Tune these to reduce GitHub API usage when you hit rate limits. The orchestrator
# poll picks up newly-dispatched issues from the local store; the background sync
# pulls remote issues/PRs into that store.
# SYMPHONY_POLL_INTERVAL_MS=60000          # orchestrator poll loop (default 60s)
# PR follow-up monitor tick interval (defaults to SYMPHONY_POLL_INTERVAL_MS)
# SYMPHONY_PR_MONITOR_INTERVAL_MS=60000
# SYMPHONY_TRACKER_SYNC_MIN_PULL_MS=60000  # min spacing between remote pulls per project
# SYMPHONY_TRACKER_PR_SYNC_TTL_MS=300000   # re-enrich an issue's PRs at most this often

# Codex defaults for assistant chats and orchestrator dispatch fallback.
# Per-project overrides live in each project's workflow_markdown (codex: front matter).
SYMPHONY_CODEX_APPROVAL_POLICY=never
# Orchestrator / assistant Codex sandbox. Use danger-full-access for unrestricted (yolo) runs.
SYMPHONY_CODEX_THREAD_SANDBOX=danger-full-access

# --- Browser Web Push (tracker notifications) ------------------------------
# Generate with: cd elixir && mix generate.vapid.keys
# SYMPHONY_VAPID_PUBLIC_KEY=
# SYMPHONY_VAPID_PRIVATE_KEY=
# SYMPHONY_VAPID_SUBJECT=mailto:you@example.com

# --- Coding agent backends ---------------------------------------------------
# Instance-wide default agent kind (codex | claude | cursor); per-task labels
# (symphony:<kind>) and per-project agent.kind override it.
# SYMPHONY_DEFAULT_AGENT_KIND=codex
# CLI commands for each backend (first word is probed for availability).
# SYMPHONY_CODEX_COMMAND="codex --config shell_environment_policy.inherit=all app-server"
# SYMPHONY_CLAUDE_COMMAND=claude
# SYMPHONY_CURSOR_COMMAND=cursor-agent
