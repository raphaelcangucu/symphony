# Copy to `.env` and fill in the values for your environment.
# Quick bootstrap (requires authenticated gh): make env-setup
# Blank secrets are treated as "unset" by the app.

SYMPHONY_TRACKER_TOKEN=
GITHUB_TOKEN=

# --- JIRA Cloud tracker ----------------------------------------------------
# Used when the active tracker kind is "jira" (set jira.project_key in the project's workflow_markdown).
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Optional: restrict polling to a single assignee (defaults to JIRA_EMAIL).
JIRA_ASSIGNEE=

# Local tracker SQLite database path (relative to the elixir/ working dir, or absolute).
SYMPHONY_LOCAL_TRACKER_DATABASE=.symphony/tracker.sqlite3

# --- Public preview tunnel (Cloudflare) ------------------------------------
# Exposes the tracker + dev-server previews via a Cloudflare named tunnel.
# Leave the secrets blank to keep the tunnel disabled.
CLOUDFLARE_ZONE_NAME=cods.dev
PUBLIC_TUNNEL_BASE_DOMAIN=tracker.cods.dev
CLOUDFLARED_TUNNEL_NAME=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ZONE_ID=

# Override the preview namespace (defaults to the operator's GitHub login).
PUBLIC_NAMESPACE=
# When "true", `make tunnel` runs `mix symphony.tunnel.dns` before starting.
PUBLIC_TUNNEL_ROUTE_DNS=false

# --- Browser editor (code-server) -------------------------------------------
# Process-wide editor settings (not per-project workflow_markdown).
# SYMPHONY_EDITOR_ENABLED=true
# SYMPHONY_EDITOR_PORT=4002
# SYMPHONY_EDITOR_HOST=127.0.0.1

# --- GitHub polling & tracker sync cadence ----------------------------------
# Tune these to reduce GitHub API usage when you hit rate limits. The orchestrator
# poll picks up newly-dispatched issues from the local store; the background sync
# pulls remote issues/PRs into that store.
# SYMPHONY_POLL_INTERVAL_MS=60000          # orchestrator poll loop (default 60s)
# PR follow-up monitor tick interval (defaults to SYMPHONY_POLL_INTERVAL_MS)
# SYMPHONY_PR_MONITOR_INTERVAL_MS=60000
# SYMPHONY_TRACKER_SYNC_MIN_PULL_MS=60000  # min spacing between remote pulls per project
# SYMPHONY_TRACKER_PR_SYNC_TTL_MS=300000   # re-enrich an issue's PRs at most this often

# Codex defaults for assistant chats and orchestrator dispatch fallback.
# Per-project overrides live in each project's workflow_markdown (codex: front matter).
SYMPHONY_CODEX_APPROVAL_POLICY=never
# SYMPHONY_CODEX_THREAD_SANDBOX=workspace-write
