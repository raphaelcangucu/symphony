{
  "name": "symphony-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:debug": "expo prebuild --platform android && cd android && NODE_ENV=development ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "build:android:e2e": "EXPO_PUBLIC_E2E_FIXTURES=1 expo prebuild --platform android && cd android && NODE_ENV=production EXPO_PUBLIC_E2E_FIXTURES=1 ./gradlew assembleRelease -PreactNativeArchitectures=x86_64",
    "build:android:release": "expo prebuild --platform android && cd android && NODE_ENV=production ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "export:web": "expo export --platform web",
    "test": "npm run test:unit && npm run test:ui",
    "test:e2e:android": "bash e2e/android-smoke.sh",
    "test:unit": "vitest run",
    "test:ui": "jest --runInBand",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "base64-js": "^1.5.1",
    "expo": "^55.0.27",
    "expo-camera": "~55.0.21",
    "expo-constants": "^55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-device": "~55.0.19",
    "expo-font": "~55.0.8",
    "expo-linking": "^55.0.15",
    "expo-notifications": "~55.0.25",
    "expo-router": "^55.0.14",
    "expo-secure-store": "^55.0.13",
    "expo-speech-recognition": "3.1.3",
    "expo-splash-screen": "^55.0.20",
    "expo-status-bar": "^55.0.6",
    "expo-system-ui": "~55.0.20",
    "lucide-react-native": "^1.25.0",
    "phoenix": "^1.8.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.14",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "jest-expo": "55.0.20",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.71.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
